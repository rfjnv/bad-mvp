# Postgres на Neon (neon.tech).
# DATABASE_URL — строка с включённым Connection pooling (хост с «-pooler»), для приложения.
# DIRECT_URL  — та же база без пулера (хост без «-pooler»), только для миграций.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

SESSION_SECRET="change-me"

# Payme — боевые ключи от провайдера. Пусто = режим песочницы.
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""

# Click — боевые ключи от провайдера. Пусто = режим песочницы.
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""

# Экран демо-оплаты для показа (/payment/process/<orderId>) — доступен,
# только если "1" И запрашивающий вошёл в админку. Держите выключенным
# (пусто) в обычное время, включайте на Render перед демо и выключайте
# сразу после — это не платёжный экран, а заглушка для презентации.
DEMO_PAYMENTS_ENABLED=""

# Telegram-бот для напоминаний о приёме. Пусто = режим песочницы.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Секрет вебхука бота: Telegram присылает его в заголовке
# X-Telegram-Bot-Api-Secret-Token, так вебхук отличает Telegram от угадавшего URL.
# На Render генерируется автоматически (render.yaml). Локально не нужен —
# вебхук на localhost всё равно недоступен Telegram'у.
TELEGRAM_WEBHOOK_SECRET=""

# Публичный адрес сайта — нужен только скрипту scripts/ensure-telegram-webhook.ts,
# чтобы сказать Telegram, куда слать апдейты. На Render берётся из
# RENDER_EXTERNAL_URL автоматически, эту переменную задавать не нужно.
PUBLIC_SITE_URL=""

# Чат магазина, куда бот шлёт новые заказы и оплаты. Пусто = сообщения
# печатаются в лог сервера. Узнать свой chat_id: написать боту @userinfobot.
TELEGRAM_ADMIN_CHAT_ID=""

# Вход без Telegram для локальной разработки (виджет привязан к домену и на localhost не работает).
# В production игнорируется. Обе переменные — "1", чтобы включить.
TELEGRAM_LOGIN_DEV_BYPASS=""
NEXT_PUBLIC_TELEGRAM_LOGIN_DEV=""

# Секрет для внешнего планировщика напоминаний: POST /api/cron/reminders с заголовком Authorization: Bearer <секрет>
CRON_SECRET=""
