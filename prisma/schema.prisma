generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Приложение — через пулер Neon (PgBouncer), миграции — напрямую:
  // пулер не держит advisory lock, и migrate deploy падает с P1002
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  NEW
  CONFIRMED
  /// Собран на складе
  PACKED
  /// Передан курьеру — на этом переходе есть телефон курьера, если задан
  WITH_COURIER
  /// В пути к покупателю
  IN_TRANSIT
  SHIPPED
  DELIVERED
  CANCELLED
  /// Возврат — отдельная ветка, не продолжение обычной цепочки статусов
  RETURNED
}

/// Категория исходящего сообщения бота — для общего суточного бюджета
/// и приоритета при его превышении (см. src/lib/botMessageBudget.ts)
enum BotMessageCategory {
  ORDER_STATUS
  DELIVERY_PROMPT
  BANK_REMINDER
  INTAKE_REMINDER
}

enum PaymentMethod {
  CASH
  PAYME
  CLICK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  /// Подтверждено через демо-экран (админ, без боевых ключей) — деньги
  /// не списаны. Отдельный статус, а не PAID: не должен попадать
  /// в выручку и аналитику ни при каких обстоятельствах.
  DEMO_PAID
}

/// Единица, в которой считается упаковка и суточная доза
enum UnitType {
  CAPSULE
  TABLET
  GRAM
  ML
  SCOOP
}

/// Статус напоминания «банка заканчивается»
enum ReminderStatus {
  PENDING
  SENT
  NO_CHANNEL
  REPEATED
}

/// Слот приёма в течение дня — для собственного напоминания по каждому
/// слоту вместо одного пакета всех товаров разом
enum RoutineSlot {
  MORNING
  AFTERNOON
  EVENING
}

/// TAKEN — принял, SKIPPED — осознанно пропустил (не путать с «не отметил
/// вообще»: у такого дня строки в IntakeLog просто нет)
enum IntakeStatus {
  TAKEN
  SKIPPED
}

/// Статус вопроса «это вам или в подарок?» после доставки заказа
enum DeliveryPromptStatus {
  PENDING
  SENT
  /// Нажали «Позже» — через 2 дня разовый повтор, дальше не спрашиваем
  SNOOZED
  ANSWERED_SELF
  ANSWERED_GIFT
  /// Гость без Telegram-канала — некому отправить, но вопрос не потерян
  NO_CHANNEL
}

enum SubscriptionPlan {
  BASIC
  COMPLEX
  PREMIUM
}

enum SubscriptionStatus {
  NEW
  CONTACTED
  ACTIVE
  CANCELLED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  /// «Какая форма для чего» — короткий текст под фильтром категории.
  /// Редактируется в админке, не зашит в код.
  formGuide String?
  products  Product[]
}

model Product {
  id                      String        @id @default(cuid())
  slug                    String        @unique
  name                    String
  brand                   String
  category                Category      @relation(fields: [categoryId], references: [id])
  categoryId              String
  description             String
  composition             String
  dosage                  String
  price                   Int
  oldPrice                Int?
  stock                   Int           @default(0)
  imageUrl                String
  sesCertNumber           String?
  sesCertFileUrl          String?
  sesCertIssuedAt         DateTime?
  sesCertExpiresAt        DateTime?
  conformityCertNumber    String?
  conformityCertFileUrl   String?
  conformityCertIssuedAt  DateTime?
  conformityCertExpiresAt DateTime?
  activeSubstance         String?
  activeAmount            Float?
  activeUnit              String?
  servingsPerPackage      Int?
  /// Сколько единиц в упаковке (капсул, таблеток, граммов, мл). Заполняется
  /// явно, а не парсится из названия при каждом показе.
  unitsPerPack            Int?
  unitType                UnitType?
  /// Единиц в день по инструкции. durationDays = unitsPerPack / dailyDose
  /// считается в src/lib/duration.ts — одно место вместо хранимой копии.
  dailyDose               Float?
  /// Форма действующего вещества (цитрат, глицинат, пиколинат…) — голая цена
  /// за мг убивает продажу более дорогой формы без объяснения, почему она дороже.
  form                    String?
  /// Одна строка: почему эта форма дороже/дешевле, мягче/жёстче и т.п.
  formNote                String?
  /// «Кому не подходит» — только по этикетке/вкладышу производителя, не
  /// вывод из состава. Пусто, если ограничение не заявлено производителем.
  /// Это свойство товара, а не правило совместимости — не участвует
  /// в src/lib/compatibility.ts.
  contraindications       String?
  isActive                Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  orderItems              OrderItem[]
  bundleItems             BundleItem[]
  routineItems            RoutineItem[]
  intakeLogs              IntakeLog[]

  @@index([categoryId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  customerPhone   String
  customerAddress String
  comment         String?
  status          OrderStatus   @default(NEW)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  totalAmount     Int
  items           OrderItem[]
  /// Ставится при переходе в DELIVERED; от неё считается, когда закончится банка
  deliveredAt     DateTime?
  /// Телефон курьера — показывается в уведомлении «Передан курьеру», если задан
  courierPhone    String?
  /// Причина отмены — показывается в уведомлении «Отменён»
  cancelReason    String?
  /// Слияние уведомлений о статусе в пределах часа (Задача C, пункт 4):
  /// lastNotifiedStatus/At — что и когда реально ушло клиенту последний раз;
  /// pendingNotifyStatus — более новый статус, ещё не отправленный, потому
  /// что не прошло часа с прошлой отправки. Часовой cron досылает его одним
  /// сообщением, как только час пройдёт.
  lastNotifiedStatus  OrderStatus?
  lastNotifiedAt      DateTime?
  pendingNotifyStatus OrderStatus?
  /// Случайный токен для страницы «Повторить заказ» из напоминания — без пароля
  repeatToken     String?       @unique
  /// Если заказ сделан со страницы повтора — ссылка на исходный, для конверсии
  repeatOfId      String?
  user            User?         @relation(fields: [userId], references: [id])
  userId          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deliveryPrompt  DeliveryPrompt?
  plans           Plan[]

  @@index([userId])
}

model OrderItem {
  id               String    @id @default(cuid())
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  product          Product   @relation(fields: [productId], references: [id])
  productId        String
  quantity         Int
  priceAtPurchase  Int
  /// deliveredAt + durationDays × quantity; пересчитывается при доставке
  expectedFinishAt DateTime?
  reminder         Reminder?

  @@index([orderId])
  @@index([productId])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionRequest {
  id            String             @id @default(cuid())
  plan          SubscriptionPlan
  customerName  String
  customerPhone String
  age           Int?
  goals         String
  healthNotes   String?
  comment       String?
  status        SubscriptionStatus @default(NEW)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Bundle {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  discountPct Int
  imageUrl    String
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       BundleItem[]
}

model BundleItem {
  id        String  @id @default(cuid())
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId  String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@unique([bundleId, productId])
  @@index([productId])
}

model Counter {
  id    String @id
  value Int    @default(0)
}

model AdminUser {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Событие поведения на витрине. Анонимно: sessionId — случайный
/// идентификатор браузера, никаких имён, телефонов и IP.
/// Из этих строк собирается воронка и статистика подбора в админке.
model Event {
  id        String   @id @default(cuid())
  /// page_view, product_view, add_to_cart, checkout_start, order_created,
  /// goal_select, condition_select, search, bundle_add
  type      String
  sessionId String
  /// Путь страницы для page_view; для остальных — где произошло событие
  path      String?
  /// Главный атрибут события: slug товара, цели, условия или поисковый запрос
  key       String?
  /// Дополнительные данные в JSON: количество, число результатов, сумма
  meta      String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

/// Напоминание «банка заканчивается» по позиции заказа.
/// orderItemId уникален — одно напоминание на позицию, идемпотентность
/// обеспечивает база, а не планировщик.
model Reminder {
  id            String         @id @default(cuid())
  orderItem     OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId   String         @unique
  dueAt         DateTime
  status        ReminderStatus @default(PENDING)
  sentAt        DateTime?
  /// Заказ, оформленный по ссылке из этого напоминания
  repeatOrderId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, dueAt])
}

/// Вопрос «это вам или в подарок?» после перехода заказа в DELIVERED.
/// orderId уникален — один вопрос на заказ, идемпотентность на уровне базы,
/// как и у Reminder.
model DeliveryPrompt {
  id             String               @id @default(cuid())
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String               @unique
  status         DeliveryPromptStatus @default(PENDING)
  sentAt         DateTime?
  snoozedAt      DateTime?
  followUpSentAt DateTime?
  answeredAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, snoozedAt])
}

/// План приёма, которым можно поделиться — «в подарок» из DeliveryPrompt.
/// Владелец и получатель — не поля заказа, а отдельная сущность (см. чат):
/// позже на этих же парах (ownerId, recipientUserId) можно построить «Мою семью»,
/// не трогая Order.
model Plan {
  id              String    @id @default(cuid())
  /// Длинный криптослучайный токен для /plan/<token>. Меняется при отзыве —
  /// старый токен просто перестаёт существовать, а не «занят».
  token           String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  /// Пусто для гостя, выбравшего «в подарок» без входа — привязывается,
  /// когда гость впервые войдёт на странице заказа (см. /api/orders/[id]/claim)
  owner           User?     @relation("PlanOwner", fields: [ownerId], references: [id])
  ownerId         String?
  recipient       User?     @relation("PlanRecipient", fields: [recipientUserId], references: [id])
  recipientUserId String?
  /// Личный текст отправителя («Пап, магний по 2 капсулы после ужина»)
  comment         String?
  claimedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([ownerId])
  @@index([recipientUserId])
}

/// Покупатель, вошедший через Telegram. Пароля нет: личность подтверждает
/// подпись Telegram Login Widget (HMAC на токене бота), проверенная на сервере.
model User {
  id               String        @id @default(cuid())
  /// Telegram user id. Строка, а не Int: id уже превышают 2^31
  telegramId       String        @unique
  firstName        String
  username         String?
  photoUrl         String?
  /// Три независимых переключателя — отключение одного не трогает
  /// остальные. remindersEnabled исторически называется так, но означает
  /// именно «банка заканчивается» — единственное, для чего он и служил.
  remindersEnabled               Boolean @default(true)
  intakeRemindersEnabled         Boolean @default(true)
  orderStatusNotificationsEnabled Boolean @default(true)
  remindDaysBefore Int           @default(7)
  /// Час отправки по Ташкенту, 0–23 — для позиций «Моего приёма» без слота
  /// (обратная совместимость) и для напоминания «банка заканчивается»
  remindHour       Int           @default(10)
  /// Час отправки по слотам — для позиций, которым назначен timeSlot
  remindHourMorning   Int        @default(8)
  remindHourAfternoon Int        @default(13)
  remindHourEvening   Int        @default(19)
  /// Вход через Login Widget НЕ даёт боту права писать пользователю —
  /// для этого нужен отдельный /start по deep-link. NULL = бот не может
  /// слать напоминания; заполняется при успешной привязке, обнуляется,
  /// если Telegram вернул 403 (пользователь заблокировал бота).
  reminderChannelConnectedAt DateTime?
  /// Одноразовый токен для t.me/<bot>?start=<token> — привязывает канал
  /// к уже существующему аккаунту, а не к браузеру
  pendingLinkToken           String?   @unique
  pendingLinkTokenExpiresAt  DateTime?
  createdAt        DateTime      @default(now())
  lastLoginAt      DateTime      @default(now())
  orders           Order[]
  routine          RoutineItem[]
  intake           IntakeLog[]
  plansSent        Plan[]        @relation("PlanOwner")
  plansReceived    Plan[]        @relation("PlanRecipient")
  slotRemindersSent      SlotReminderSent[]
  compatibilityDismissals CompatibilityDismissal[]
  botMessageLogs          BotMessageLog[]
}

/// Товар в списке приёма пользователя. Серверная замена localStorage —
/// переносится между устройствами и даёт канал для напоминаний.
model RoutineItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  /// Своя доза, если отличается от дозы товара по умолчанию
  dailyDose Float?
  sortOrder Int      @default(0)
  /// Утро/день/вечер — не задан по умолчанию, назначается в «Моём приёме»
  timeSlot  RoutineSlot?
  /// На паузе: не считается ни принятым, ни пропущенным, серия не рвётся,
  /// напоминания не шлются, пока не задано значение null (снята с паузы)
  pausedAt  DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

/// Отметка за день. Дата — строка YYYY-MM-DD по локальному дню
/// пользователя, чтобы полночь по UTC не резала серии. Отсутствие строки
/// за день значит «не отметил», а не «пропустил» — это разные вещи
/// (см. обсуждение остатка банки в чате).
model IntakeLog {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  date      String
  status    IntakeStatus @default(TAKEN)
  createdAt DateTime     @default(now())

  @@unique([userId, productId, date])
  @@index([userId, date])
}

/// Разовая рассылка «не забудьте приём» по слоту за день — идемпотентность
/// вместо угадывания «уже слал или нет» по времени последнего запуска cron.
model SlotReminderSent {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  /// "MORNING" / "AFTERNOON" / "EVENING" или "DEFAULT" — для позиций без
  /// слота, объединённых в одно ежедневное напоминание в remindHour.
  /// Строка, а не RoutineSlot: DEFAULT не должно быть значением, которое
  /// можно назначить самому RoutineItem.timeSlot — это разные вещи.
  slot   String
  date   String
  sentAt DateTime @default(now())

  @@unique([userId, slot, date])
}

/// Суточный бюджет сообщений бота на пользователя — см.
/// src/lib/botMessageBudget.ts. Считаем факт отправки, не намерение.
model BotMessageLog {
  id       String             @id @default(cuid())
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  category BotMessageCategory
  sentAt   DateTime           @default(now())

  @@index([userId, sentAt])
}

/// «Понятно, не показывать» на предупреждении о совместимости в «Моём
/// приёме» — запоминание на уровне конкретной пары/вещества (key —
/// тот же InteractionMatch.key из src/lib/compatibility.ts), не глобально.
model CompatibilityDismissal {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  key       String
  createdAt DateTime @default(now())

  @@unique([userId, key])
}
